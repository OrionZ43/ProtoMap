rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isNotBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true;
    }

    // Реакции у постов и сообщений — словарь {uid: эмодзи}, одна на человека:
    // каждый меняет только свою запись, а не весь словарь
    function onlyOwnReactionChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.get('reactions', {})
               .diff(resource.data.get('reactions', {})).affectedKeys()
               .hasOnly([request.auth.uid])
          && (
               !(request.auth.uid in request.resource.data.get('reactions', {}))
               || (request.resource.data.reactions[request.auth.uid] is string
                   && request.resource.data.reactions[request.auth.uid].size() <= 64)
             );
    }

    // Чёрный список: users/{кто}/blocked/{кого}. Если собеседник по личке
    // заблокировал пишущего, тот не пишет ни сообщений, ни сам документ чата
    // (иначе поднимал бы чат в списке и крутил счётчик). Пара — из id чата.
    function blockedByChatPartner(chatId) {
      let ids = chatId.split('_');
      let other = ids[0] == request.auth.uid ? ids[1] : ids[0];
      return other != request.auth.uid
          && exists(/databases/$(database)/documents/users/$(other)/blocked/$(request.auth.uid));
    }

    // Заблокированный в личке может только обнулить свой счётчик непрочитанного
    // и погасить свой «печатает»: иначе значок непрочитанного в его списке
    // чатов застревал бы навсегда. Собеседнику это ничего не отправляет.
    function onlyOwnUnreadReset() {
      let me = request.auth.uid;
      let unreadNow = request.resource.data.get('unreadCount', {});
      let unreadWas = resource.data.get('unreadCount', {});
      let typingNow = request.resource.data.get('typing', {});
      let typingWas = resource.data.get('typing', {});
      // Своё значение либо не меняется, либо становится нулём / false
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount', 'typing'])
          && unreadNow.diff(unreadWas).affectedKeys().hasOnly([me])
          && (unreadNow.get(me, 0) == 0 || unreadNow.get(me, 0) == unreadWas.get(me, 0))
          && typingNow.diff(typingWas).affectedKeys().hasOnly([me])
          && (typingNow.get(me, false) == false || typingNow.get(me, false) == typingWas.get(me, false));
    }

    // Отметка о прочтении в личке: read_by — словарь {uid: время}, каждый
    // ставит только свою
    function onlyOwnReadMarkChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by'])
          && request.resource.data.get('read_by', {})
               .diff(resource.data.get('read_by', {})).affectedKeys()
               .hasOnly([request.auth.uid]);
    }

    // ── Комментарии каналов ─────────────────────────────────────────────────
    // Комментарии к постам живут в технической группе канала (isTechnical),
    // топик = пост. Группа приватная, подписчиков в memberUids никто не
    // добавляет, поэтому доступ к ней даём через канал. Ссылки проверяем в
    // обе стороны (group.linkedChannelId ↔ channel.linkedGroupId), как и
    // функции в channelComments.ts: одной ссылке верить нельзя.

    function commentsChannel(groupId) {
      let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return g.get('isTechnical', false) == true
          ? get(/databases/$(database)/documents/channels/$(g.linkedChannelId)).data
          : null;
    }

    function isChannelCommentsGroup(groupId) {
      let ch = commentsChannel(groupId);
      return ch != null && ch.get('linkedGroupId', '') == groupId;
    }

    // Писать комментарии могут только подписчики канала и его владелец
    function isChannelSubscriber(groupId) {
      let ch = commentsChannel(groupId);
      return isChannelCommentsGroup(groupId)
          && (request.auth.uid in ch.get('subscriberUids', []) || ch.ownerUid == request.auth.uid);
    }

    // =========================================================
    // 💬 РАЗДЕЛ 2: ЛИЧНЫЕ СООБЩЕНИЯ
    // =========================================================

    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
          request.auth.uid in resource.data.participantIds ||
          resource.data.participants[request.auth.uid] != null ||
          isAdmin()
      );
      allow write: if isAuthenticated()
                   && chatId.matches('.*_.*')
                   && request.auth.uid in chatId.split('_')
                   && (!blockedByChatPartner(chatId) || onlyOwnUnreadReset());

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
            request.auth.uid in chatId.split('_') || isAdmin()
        );
        allow create: if isAuthenticated()
                      && chatId.matches('.*_.*')
                      && request.auth.uid in chatId.split('_')
                      && request.resource.data.author_uid == request.auth.uid
                      && !blockedByChatPartner(chatId);
        // Своё сообщение участник правит и удаляет (кроме автора, времени и
        // типа), в чужом — только своя реакция и своя отметка о прочтении.
        // До 21.10.2026 он мог переписать и чужое: текст, медиа, «удалено».
        // Свою отметку о прочтении ставит и заблокированный: иначе непрочитанное
        // в его списке чатов не гасло бы никогда. Остальное ему закрыто.
        allow update: if isAuthenticated()
                      && chatId.matches('.*_.*')
                      && request.auth.uid in chatId.split('_')
                      && request.resource.data.author_uid == resource.data.author_uid
                      && (
                           onlyOwnReadMarkChanged()
                           || (!blockedByChatPartner(chatId)
                               && ((resource.data.author_uid == request.auth.uid
                                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['author_uid', 'createdAt', 'created_at', 'type']))
                                   || onlyOwnReactionChanged()))
                         );
        allow delete: if isAuthenticated() && (
            resource.data.author_uid == request.auth.uid || isAdmin()
        );
      }
    }

    // =========================================================
    // 👤 РАЗДЕЛ 3: ПОЛЬЗОВАТЕЛИ
    // =========================================================

    match /users/{userId} {
      allow get:  if true;
      allow list: if false;   // ← закрыт массовый слив коллекции

      // 🔒 Приватные данные пользователя (fcmToken / список токенов на будущее).
      //    Email тут НЕ храним — он и так есть в Firebase Auth.
      //    Читает и пишет только владелец; сервер (Admin SDK) читает в обход правил.
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Поля, которые пишет только сервер — функции и сайт через Admin SDK. За
      // каждым стоит проверка, которую прямая запись обошла бы: баланс и вещи,
      // бан, 2FA и Telegram, ник (уникальность, запретные слова, раз в 30 дней),
      // профиль (длина, модерация аватара), надетые вещи (куплены ли), бонусы,
      // античит шагомера, копии согласий, метки пауз антиспама.
      //
      // До 20.10.2026 здесь был короткий список запретов, а остальное владелец
      // писал сам: снимал себе 2FA, сбрасывал флаг праздничного бонуса и получал
      // его снова, надевал некупленную рамку, ставил аватаром любую картинку мимо
      // модерации. Админам правило открывало вообще все поля — так 19.10.2026 и
      // вписали 23 055 PC. Это заплатка: правильнее — список разрешённых полей,
      // когда журнал записей Firestore покажет всё, что старое Android-приложение
      // пишет напрямую (docs/CHANGELOG_CLAUDE.md, 20.10.2026).
      function serverOwnedUserFields() {
        return [
          'casino_credits', 'glitch_shards', 'owned_items', 'daily_streak', 'last_daily_bonus', 'econ_op',
          'role', 'email', 'createdAt', 'migratedAt', 'migratedFrom',
          'isBanned', 'banReason', 'bannedAt', 'banCategory', 'bannedUntil',
          'is2FAEnabled', 'telegram_id', 'telegram_username', 'telegram_chat_verified', 'telegram_chat_verified_at',
          'username', 'last_username_change', 'username_chosen_at', '_created_by',
          'avatar_url', 'about_me', 'status', 'socials', 'social_link',
          'equipped_frame', 'equipped_bg', 'equipped_badge',
          'birthday_bonus_claimed', 'referralBonusClaimed', 'stepperAnomalyFlag',
          'consents_privacy_version', 'consents_tos_version', 'consents_updated_at',
          'activity_data_consent', 'activity_leaderboard_consent',
          'last_game_played', 'last_crash_game', 'last_bonus_game', 'last_chat_message',
          'last_avatar_upload', 'last_location_update'
        ];
      }

      // Поле нового документа: его нет или у него пустое значение по умолчанию.
      function absentOr(field, allowed) {
        return !(field in request.resource.data) || request.resource.data[field] in allowed;
      }

      allow create: if request.auth != null
        && request.auth.uid == userId
        && 'username'  in request.resource.data
        && 'createdAt' in request.resource.data
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && (!('lastBackupSignature' in request.resource.data) || request.resource.data.lastBackupSignature is string)
        && (!('casino_credits'   in request.resource.data) || request.resource.data.casino_credits   == 100)
        && (!('glitch_shards'    in request.resource.data) || request.resource.data.glitch_shards    == 0)
        && (!('daily_streak'     in request.resource.data) || request.resource.data.daily_streak     == 0)
        && !('role' in request.resource.data)
        && (!('owned_items'      in request.resource.data) || (request.resource.data.owned_items is list && request.resource.data.owned_items.size() == 0))
        && (!('isBanned'         in request.resource.data) || request.resource.data.isBanned         == false)
        && (!('last_daily_bonus' in request.resource.data) || request.resource.data.last_daily_bonus == null)
        // Серверные поля при создании — только пустые: иначе аккаунт можно сразу
        // завести с некупленной рамкой, чужим telegram_id или аватаром мимо
        // модерации. Аватар — пустой или фото Google: его потом переносит в
        // Cloudinary migrateExternalAvatar. Уникальность ника правила проверить
        // не могут — это закроет перенос создания документа на сервер.
        && absentOr('is2FAEnabled', [false])
        && absentOr('telegram_id', [null])
        && absentOr('telegram_username', [null])
        && absentOr('telegram_chat_verified', [false])
        && absentOr('telegram_chat_verified_at', [null])
        && absentOr('birthday_bonus_claimed', [false])
        && absentOr('referralBonusClaimed', [false])
        && absentOr('stepperAnomalyFlag', [null, false, 0])
        && absentOr('equipped_frame', [null, ''])
        && absentOr('equipped_bg', [null, ''])
        && absentOr('equipped_badge', [null, ''])
        && absentOr('last_username_change', [null])
        // По этим двум setInitialUsername решает, можно ли один раз сменить ник
        && absentOr('username_chosen_at', [null])
        && absentOr('_created_by', [null])
        && absentOr('banReason', [null, ''])
        && absentOr('bannedAt', [null])
        && absentOr('banCategory', [null])
        && absentOr('bannedUntil', [null])
        && absentOr('consents_privacy_version', [null])
        && absentOr('consents_tos_version', [null])
        && absentOr('consents_updated_at', [null])
        && absentOr('activity_data_consent', [null, false])
        && absentOr('activity_leaderboard_consent', [null, false])
        && absentOr('econ_op', [null])
        && absentOr('migratedAt', [null])
        && absentOr('migratedFrom', [null])
        && absentOr('social_link', [null, ''])
        && absentOr('last_game_played', [null])
        && absentOr('last_crash_game', [null])
        && absentOr('last_bonus_game', [null])
        && absentOr('last_chat_message', [null])
        && absentOr('last_avatar_upload', [null])
        && absentOr('last_location_update', [null])
        && (!('socials' in request.resource.data) || request.resource.data.socials == null
            || (request.resource.data.socials is map && request.resource.data.socials.size() == 0))
        && (!('avatar_url' in request.resource.data) || request.resource.data.avatar_url == ''
            || (request.resource.data.avatar_url is string
                && request.resource.data.avatar_url.matches('https://lh[0-9]+[.]googleusercontent[.]com/.*')))
        && (!('about_me' in request.resource.data)
            || (request.resource.data.about_me is string && request.resource.data.about_me.size() <= 500))
        && (!('status' in request.resource.data)
            || (request.resource.data.status is string && request.resource.data.status.size() <= 100));

      // Токен уведомлений и подпись резервной копии — даже забаненному владельцу.
      allow update: if isOwner(userId)
              && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['fcmToken', 'lastBackupSignature']);

      // Остальное владелец меняет сам, кроме серверных полей. Админам отдельного
      // права нет: админка сайта пишет через сервер, правила ей не нужны.
      allow update: if isOwner(userId)
                    && isNotBanned()
                    && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedUserFields()))
                    && (!('lastBackupSignature' in request.resource.data) || request.resource.data.lastBackupSignature is string);

      allow delete: if isSuperAdmin();

      // Чёрный список (решение Ориона 21.10.2026, «как в Telegram»): кого
      // заблокировали, тот не пишет в личку, не комментирует профиль и не видит
      // аватар, описание и ссылки. Ведёт владелец; тот, кого заблокировали,
      // может прочитать только свою запись — так клиенты прямо говорят ему
      // «Вы в чёрном списке», не дожидаясь отказа при отправке.
      match /blocked/{blockedUid} {
        allow get:    if isOwner(userId) || (isAuthenticated() && request.auth.uid == blockedUid);
        allow list:   if isOwner(userId);
        allow create: if isOwner(userId)
                      && blockedUid != userId
                      && request.resource.data.keys().hasOnly(['createdAt'])
                      && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /notifications/{notifId} {
        // Лента уведомлений. Создаёт только сервер (триггеры/функции). Владелец
        // читает и может лишь пометить прочитанным (read: false → true) — больше
        // ничего: остальные поля и удаление клиенту недоступны.
        allow read:   if isOwner(userId);
        allow create: if false;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && resource.data.read == false
          && request.resource.data.read == true;
        allow delete: if false;
      }

      match /comments/{commentId} {
        allow get:  if true;
        allow list: if true;
        // Комментарий создаёт только addComment: лимит частоты, длина, почта,
        // имя автора из профиля. До 21.10.2026 прямое создание обходило всё это
        // и давало подделать автора, лайки и дату. Сайт и оба приложения пишут
        // через функцию.
        allow create: if false;
        allow update: if false;
        allow delete: if isAdmin()
                      || (isAuthenticated() && resource.data.author_uid == request.auth.uid)
                      || (isAuthenticated() && userId == request.auth.uid);
      }
    }

    // =========================================================
    // 📜 РАЗДЕЛ 3.1: ЖУРНАЛ СОГЛАСИЙ (Закон № 99-З, п. 7 ст. 5)
    // =========================================================
    //
    // Бремя доказывания наличия согласия лежит на операторе. Поэтому запись
    // создаётся ТОЛЬКО Cloud Function через Admin SDK: журнал, который может
    // писать клиент, доказательственной силы не имеет.
    //
    // Записи неизменяемы. Отзыв согласия не удаляет и не переписывает запись,
    // а проставляет revokedAt отдельной функцией.
    //
    // Коллекция верхнеуровневая, а не подколлекция users/{uid}: журнал обязан
    // пережить удаление аккаунта (заявленный в Политике срок — 3 года), и его
    // должна уметь обходить функция ретеншена.

    match /consents/{consentId} {
      allow read:  if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // =========================================================
    // ⬇️ РАЗДЕЛ 3.2: ОЧЕРЕДЬ СКАЧИВАНИЯ
    // =========================================================
    //
    // Задачи кладёт бот (Cloud Function), забирает воркер на сервере — оба
    // через Admin SDK, в обход правил. Клиенту доступ закрыт полностью:
    // в задаче лежит произвольный URL, который исполнится на чужой машине,
    // и давать браузеру возможность туда писать нельзя ни в каком виде.

    match /tg_download_queue/{jobId} {
      allow read:  if false;
      allow write: if false;
    }

    // =========================================================
    // ⚙️ РАЗДЕЛ 4: СИСТЕМНЫЕ КОЛЛЕКЦИИ
    // =========================================================

    match /system/licenses {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /system/map_cache {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    match /system/banned_users {
      // Индекс забаненных: один документ { uids, updatedAt }. Читают все
      // вошедшие — для плашек «Забанен» в чате, группах, комментариях; пишет
      // только сервер (триггер activityOnUserWrite). Приватности не убавляет:
      // isBanned и так читается у users/{uid}.
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Пульс воркера скачивания (worker/ в репозитории). Пишет его воркер через
    // Admin SDK, читает команда /dlstatus в боте — тоже сервер. Клиенту здесь
    // делать нечего.
    match /system/downloader_status {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /system/casino_stats {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /system/telegram_codes/{document=**} {
      allow read:  if false;
      allow write: if false;
    }

    match /system/vision_stats {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /system/telegram_config {
      allow read:  if false;
      allow write: if false;
    }

    match /system/android_app {
      // Версии и флаги нового Android-приложения (com.z43studios.protomap).
      // read — всем, включая до входа (проверка версии идёт до логина), как у
      // публичных mobileapp/*. Пишет только админ и только корректную форму.
      // Старые mobileapp/config|feature_flags|compatibility НЕ трогаем — это
      // контракт СТАРОГО приложения, оно может заблокировать само себя.
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.latest is int
        && request.resource.data.minimum is int
        && request.resource.data.force is bool
        && request.resource.data.flags is map
        && request.resource.data.flags.values().hasOnly([true, false]);
    }

    match /announcements/{announcementId} {
      // Объявления админов: читают все вошедшие, пишет только функция
      // sendAnnouncement (Admin SDK в обход правил). Прочитанность хранится
      // в users/{uid}.announcementsSeenAt (владельцем-писабельное поле).
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    match /mobileapp/config {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /mobileapp/beta_stats/users/{userId} {
      allow read:  if isAdmin() || isOwner(userId);
      allow write: if isOwner(userId);

      match /daily_stats/{date} {
        allow read:  if isAdmin() || isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    match /mobileapp/general/news/{newsId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /mobileapp/feature_flags {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /mobileapp/compatibility {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /mobileapp/sticker_packs {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read:  if isOwner(adminId);
      allow write: if false;
    }

    match /auth_logs/{deviceId} {
      allow list: if isAdmin();
      allow get:  if isAdmin()
                  || (isAuthenticated() && resource.data.last_uid == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.last_uid == request.auth.uid;
      allow update: if isAuthenticated()
                    && request.resource.data.last_uid == request.auth.uid;
      allow delete: if false;
    }

    // =========================================================
    // 🦶 РАЗДЕЛ 5: ШАГОМЕР
    // =========================================================

    match /stepper/{userId} {
      allow read:  if isOwner(userId);
      allow write: if false;
      match /claim_history/{claimId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }
    match /stepper_idempotency/{requestId} {
      allow read:  if false;
      allow write: if false;
    }

    // =========================================================
    // 🎮 РАЗДЕЛ 6: ИГРОВОЙ КОНТЕНТ
    // =========================================================

    match /shop_items/{itemId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /news/{newsId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    // В документе раунда лежит точка краша. До 21.10.2026 владелец раунда мог
    // его читать: модифицированный клиент узнавал точку сразу после старта и
    // забирал выигрыш перед самым крашем в каждом раунде. Клиенты следят за
    // раундом через RTDB (crash_games/{id}: m, s), этот документ им не нужен.
    match /crash_games/{gameId} {
      allow read:  if false;
      allow write: if false;
    }
    match /reports/{reportId} {
      allow create: if isAuthenticated() && isNotBanned();
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // Метки карты клиенты получают через getLocations, сайт — через Admin SDK.
    // Прямое чтение никому не нужно: до 21.10.2026 оно было открыто всем.
    match /locations/{locationId} {
      allow read:  if false;
      allow write: if false;
    }
    match /global_chat/{messageId} {
      allow read:   if true;
      allow create: if false;
      allow delete: if isAdmin();
    }

    // =========================================================
    // 🚨 РАЗДЕЛ 7: МОДЕРАЦИЯ
    // =========================================================

    match /moderation_flags/{flagId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /moderation_queue/{itemId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /telegram_moderation/{document=**} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // =========================================================
    // 🔁 РАЗДЕЛ 8: RATE LIMITS
    // =========================================================

    match /rate_limits/{userId} {
      allow read:  if false;
      allow write: if false;
    }

    // =========================================================
    // 🔐 РАЗДЕЛ 8.5: 2FA (только сервер, Admin SDK)
    // =========================================================
    // Коды 2FA и одноразовая метка "2FA пройдена". Читает и пишет ТОЛЬКО
    // сервер через Admin SDK (он обходит правила). Клиентам доступ не нужен.

    match /2fa_codes/{uid} {
      allow read, write: if false;
    }
    match /2fa_cleared/{uid} {
      allow read, write: if false;
    }

    // =========================================================
    // 📢 РАЗДЕЛ 9: КАНАЛЫ
    // =========================================================

    match /channels/{channelId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 50;

      allow update: if isAdmin()
                    || (isAuthenticated() && resource.data.ownerUid == request.auth.uid)
                    || (
                         isAuthenticated()
                         && isNotBanned()
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['subscriberUids', 'subscriberCount'])
                         // Без значений по умолчанию канал, созданный без этих полей,
                         // был бы закрыт для подписки навсегда
                         && (
                              (
                                request.auth.uid in request.resource.data.subscriberUids
                                && !(request.auth.uid in resource.data.get('subscriberUids', []))
                                && request.resource.data.subscriberUids.size() == resource.data.get('subscriberUids', []).size() + 1
                                && request.resource.data.subscriberCount == resource.data.get('subscriberCount', 0) + 1
                              )
                              ||
                              (
                                !(request.auth.uid in request.resource.data.subscriberUids)
                                && request.auth.uid in resource.data.get('subscriberUids', [])
                                && request.resource.data.subscriberUids.size() == resource.data.get('subscriberUids', []).size() - 1
                                && request.resource.data.subscriberCount == resource.data.get('subscriberCount', 0) - 1
                              )
                            )
                       );

      allow delete: if isSuperAdmin()
                    || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);

      match /posts/{postId} {
        allow read: if isAuthenticated();

        // Пост публикует только владелец канала. Раньше правило сверяло лишь
        // author_uid/owner_uid с uid, а владельца проверял только клиент: из
        // консоли браузера можно было постить в чужой канал, и триггер
        // комментариев заводил под таким постом обсуждение.
        // Поля — как пишут веб и приложение: время ставит сервер, без готовых реакций
        allow create: if isAuthenticated()
                      && isNotBanned()
                      && get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid == request.auth.uid
                      && request.resource.data.author_uid == request.auth.uid
                      && request.resource.data.owner_uid == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.get('reactions', {}) == {}
                      && request.resource.data.get('is_deleted', false) == false;

        allow update: if isAuthenticated() && (
                        resource.data.owner_uid == request.auth.uid
                        || (isNotBanned() && onlyOwnReactionChanged())
                      );

        // Владелец канала удаляет любой пост в нём — в том числе чужие,
        // успевшие появиться, пока create не проверял владельца
        allow delete: if isAuthenticated() && (
                        resource.data.owner_uid == request.auth.uid
                        || get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid == request.auth.uid
                        || isAdmin()
                      );
      }

      match /subscribers/{subscriberUid} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
                      && subscriberUid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid;
        allow update: if isAuthenticated() && subscriberUid == request.auth.uid;
        allow delete: if isAuthenticated() && (
                        subscriberUid == request.auth.uid || isAdmin()
                      );
      }
    }

    // =========================================================
    // 🗺️ РАЗДЕЛ 10: ROADMAP
    // =========================================================

    match /roadmap/{taskId} {
      allow read, write: if isAdmin();
    }

    // =========================================================
    // 🎯 РАЗДЕЛ 11: РЕФЕРАЛЬНАЯ ПРОГРАММА
    // =========================================================

    match /referrals/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
      match /claimed/{newUserId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /referral_codes/{code} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /referral_campaign/{monthKey} {
      allow read: if true;
      allow write: if false;
    }

    match /referral_idempotency/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /telegram_chat_pending/{tgId} {
      allow read: if false;
      allow write: if false;
    }

    match /telegram_chat_pending_msg/{tgId} {
      allow read: if false;
      allow write: if false;
    }

    // Незавершённые проверки возраста в Telegram-чате. Только бот.
    match /telegram_age_gate/{checkId} {
      allow read: if false;
      allow write: if false;
    }

    // Состояние подколов бота по чатам (счётчик стикерного спама). Только бот.
    match /telegram_banter/{chatId} {
      allow read: if false;
      allow write: if false;
    }

    // Минутный лимит вопросов к нейросети по чатам. Только бот.
    match /telegram_ask/{chatId} {
      allow read: if false;
      allow write: if false;
    }

    // Журнал действий (functions/src/activity). Пишут триггеры и сервер сайта,
    // читает админка сайта через Admin SDK. Клиенту — ни чтения, ни записи:
    // в журнале чужие балансы и тексты.
    match /activity_log/{entryId} {
      allow read: if false;
      allow write: if false;
    }

    // Копии аккаунтов и каналов перед баном или удалением — для возврата.
    match /moderation_backups/{backupId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================
    // 👥 РАЗДЕЛ 12: ГРУППЫ
    // =========================================================

    match /groups/{groupId} {
      allow read: if isAuthenticated() && (
          request.auth.uid in resource.data.get('memberUids', [])
          || resource.data.get('isPublic', false) == true
          || isAdmin()
      );

      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 50;

      allow update: if isAdmin()
                    || (isAuthenticated() && resource.data.ownerUid == request.auth.uid)
                    || (
                         // Генерация инвайта участниками
                         isAuthenticated()
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['inviteCode', 'inviteExpiresAt', 'inviteCreatedBy'])
                         && request.auth.uid in resource.data.get('memberUids', [])
                       )
                    || (
                         // Обновление превью последнего сообщения обычными участниками
                         isAuthenticated()
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['lastMessageText', 'lastMessageTimestamp'])
                         && request.auth.uid in resource.data.get('memberUids', [])
                       )
                    || (
                         // Вступление в публичную группу
                         isAuthenticated()
                         && isNotBanned()
                         && resource.data.get('isPublic', false) == true
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['memberUids', 'memberCount'])
                         && request.auth.uid in request.resource.data.memberUids
                         && !(request.auth.uid in resource.data.get('memberUids', []))
                         && request.resource.data.memberUids.size() == resource.data.get('memberUids', []).size() + 1
                         && request.resource.data.memberCount == resource.data.memberCount + 1
                       );

      allow delete: if isSuperAdmin()
                    || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);

      // ── Topics ──────────────────────────────────────────────────────────────
      match /topics/{topicId} {
        // Обсуждения постов канала читает любой вошедший — как и сами посты
        allow read: if isAuthenticated() && (
                      request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                      || isChannelCommentsGroup(groupId)
                    );

        allow create: if isAuthenticated()
                      && isNotBanned()
                      && (
                           get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
                           || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
                         );

        allow update: if isAuthenticated()
                      && (
                           // Владелец и админ могут менять всё (название, блокировку)
                           get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
                           || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
                           || (
                                // Обычный участник может обновлять ТОЛЬКО текст и время последнего сообщения
                                request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageText', 'lastMessageTimestamp'])
                              )
                         );

        allow delete: if isAuthenticated()
                      && (
                           get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
                           || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
                           || isAdmin()
                         );

        // ── Messages ──────────────────────────────────────────────────────────
        match /messages/{messageId} {
          allow read: if isAuthenticated() && (
                        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                        || isChannelCommentsGroup(groupId)
                      );

          allow create: if isAuthenticated()
                        && isNotBanned()
                        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                        && request.resource.data.author_uid == request.auth.uid
                        && (
                             !get(/databases/$(database)/documents/groups/$(groupId)/topics/$(topicId)).data.isLocked
                             || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
                             || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
                           );

          // Комментарий к посту канала: только подписчики канала и его владелец.
          // Поля — как пишет приложение (ответ Дениса 19.10.2026): время ставит
          // сервер, тип из четырёх, без готовых реакций; имя — из профиля автора
          // или пустое, пока профиль не загрузился, но не чужое.
          allow create: if isAuthenticated()
                        && isNotBanned()
                        && request.resource.data.author_uid == request.auth.uid
                        && isChannelSubscriber(groupId)
                        && !get(/databases/$(database)/documents/groups/$(groupId)/topics/$(topicId)).data.get('isLocked', false)
                        && request.resource.data.createdAt == request.time
                        && request.resource.data.type in ['TEXT', 'IMAGE', 'VOICE', 'STICKER']
                        && request.resource.data.get('text', '') is string
                        && request.resource.data.get('text', '').size() <= 10000
                        && request.resource.data.get('reactions', {}) == {}
                        && request.resource.data.get('is_deleted', false) == false
                        && (
                             request.resource.data.get('author_username', '') == ''
                             || request.resource.data.author_username == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '')
                           );

          // Подписчик в обсуждении поста: своя реакция на любой комментарий, правка
          // своего (edited_text + edited_at от сервера) и мягкое удаление своего.
          // Превью топика и группы подписчикам по-прежнему закрыто — оно там не нужно.
          allow update: if isAuthenticated()
                        && isNotBanned()
                        && isChannelSubscriber(groupId)
                        && (
                             onlyOwnReactionChanged()
                             || (resource.data.author_uid == request.auth.uid
                                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['edited_text', 'edited_at'])
                                 && request.resource.data.edited_text is string
                                 && request.resource.data.edited_text.size() <= 10000
                                 && request.resource.data.edited_at == request.time)
                             || (resource.data.author_uid == request.auth.uid
                                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_deleted'])
                                 && request.resource.data.is_deleted == true)
                           );

          allow update: if isAuthenticated()
                        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                        && (
                             (resource.data.author_uid == request.auth.uid
                              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['author_uid', 'createdAt', 'created_at', 'type']))
                             ||
                             onlyOwnReactionChanged()
                             ||
                             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_deleted'])
                              && (
                                   resource.data.author_uid == request.auth.uid
                                   || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
                                   || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
                                   || isAdmin()
                                 )
                             )
                           );

          allow delete: if isAdmin()
                        || (isAuthenticated() && resource.data.author_uid == request.auth.uid)
                        || (isAuthenticated() && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid)
                        || (isAuthenticated() && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin');
        }
      }

      // ── Members ────────────────────────────────────────────────────────────
      match /members/{memberUid} {
        allow read: if isAuthenticated()
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;

        // Роль при вступлении — только «member», владелец записывает себе
        // «owner». До 21.10.2026 роль не проверялась, и вступивший в
        // публичную группу мог сразу записать себе «admin».
        allow create: if isAuthenticated()
                      && isNotBanned()
                      && memberUid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && (
                           (get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
                            && request.resource.data.get('role', 'owner') == 'owner')
                           || (get(/databases/$(database)/documents/groups/$(groupId)).data.get('isPublic', false) == true
                               && request.resource.data.get('role', 'member') == 'member')
                         );

        allow update: if isAuthenticated()
                      && (
                           get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
                           || isAdmin()
                         );

        allow delete: if isAuthenticated()
                      && (
                           memberUid == request.auth.uid
                           || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
                           || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
                           || isAdmin()
                         );
      }
    }

    // =========================================================
    // 🏆 РАЗДЕЛ 13: ЛИДЕРБОРД ШАГОМЕРА
    // =========================================================
    // Пишет ТОЛЬКО сервер (stepperClaim через Admin SDK).
    // Клиентская накрутка totalSteps невозможна.

    match /stepper_leaderboard/{userId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }
  }
}
