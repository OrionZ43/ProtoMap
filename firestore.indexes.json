{
  "indexes": [
    {
      "//": "Воркер скачивания забирает задачи: status == pending, по порядку создания.",
      "collectionGroup": "tg_download_queue",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Он же ищет зависшие задачи: status == processing и claimedAt старше порога.",
      "collectionGroup": "tg_download_queue",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "claimedAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "revokeConsent ищет действующие согласия конкретного пользователя.",
      "collectionGroup": "consents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "consentId", "order": "ASCENDING" },
        { "fieldPath": "revokedAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "enforceRetention чистит журнал согласий по дате выдачи.",
      "collectionGroup": "consents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "grantedAt", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "collectionGroup": "2fa_codes",
      "fieldPath": "expiresAt",
      "ttl": true,
      "indexes": []
    }
  ]
}
