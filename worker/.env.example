# Скопировать в .env рядом с docker-compose.yml и заполнить.
# Файл .env в git не коммитится — см. .gitignore.

# Токен бота. Нужен, чтобы отправлять скачанные файлы напрямую в Telegram,
# минуя Firebase: иначе видео пойдёт исходящим трафиком из Cloud Functions,
# а бесплатных 5 ГБ в месяц на видео не хватит.
TELEGRAM_BOT_TOKEN=

# Необязательное. Значения по умолчанию заданы в src/config.ts.
# POLL_INTERVAL_MS=4000
# CONCURRENCY=2

# e621 отклоняет запросы без осмысленного User-Agent — это их правило API.
# E621_USER_AGENT=ProtoMapBot/1.0 (by Orion_Z43 on e621)
