engine-strict=true
# @firebase/rules-unit-testing@6 требует peer firebase@^13, а приложение на
# firebase@^11 — строгий npm (Vercel) падает по ERESOLVE на install. Это только
# dev-зависимость для тестов правил, в сборку/рантайм не входит. Разрешаем
# legacy-peer-deps, чтобы install проходил. Чистый фикс — выровнять версии
# (rules-unit-testing под firebase@11 или миграция firebase→13) отдельной задачей.
legacy-peer-deps=true
